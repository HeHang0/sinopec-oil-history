# GitHub SSH repository, for example:
# GIT_REPO_URL=git@github.com:your-name/sinopec-oil-history.git
GIT_REPO_URL=
GIT_BRANCH=main

# Recommended for Docker: base64 of the private key used by a Deploy Key
# with write access:  base64 -w0 ~/.ssh/oil_price_deploy
GIT_SSH_PRIVATE_KEY_B64=
# Alternative for non-Docker runs. Literal newlines or escaped \n are accepted.
# GIT_SSH_PRIVATE_KEY=
GIT_SSH_HOST=github.com

GIT_USER_NAME=oil-price-bot
GIT_USER_EMAIL=oil-price-bot@users.noreply.github.com

# Collection schedule: every N days at HH:MM in TZ.
FETCH_INTERVAL_DAYS=1
FETCH_HOUR=6
FETCH_MINUTE=0
TZ=Asia/Shanghai
RUN_ON_START=true

# Optional: comma-separated codes, names, or slugs. Empty means all provinces.
PROVINCES=

REQUEST_DELAY_SECONDS=0.4
GIT_PUSH_RETRIES=3
DRY_RUN=false

# Container defaults; normally leave these alone.
# WORK_DIR=/repo
# STATE_DIR=/state
# DATA_SUBDIR=site/data
